{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["iad1"],
  "services": {
    "backend": {
      "root": ".",
      "runtime": "container",
      "entrypoint": "docker/backend.Dockerfile"
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": { "service": "backend" } }
  ]
}
