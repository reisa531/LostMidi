# Copy to .env for Docker Compose. Values below are public local-development examples.
POSTGRES_USER=lostmidi
POSTGRES_PASSWORD=lostmidi_dev_only
POSTGRES_DB=lostmidi
POSTGRES_PORT=5432

# Docker service DNS names. For native development replace postgres/backend with 127.0.0.1.
# URL-encode reserved characters in the password when constructing DATABASE_URL.
DATABASE_URL=postgresql://lostmidi:lostmidi_dev_only@postgres:5432/lostmidi
BACKEND_API_URL=http://backend:8080

BACKEND_HOST=127.0.0.1
BACKEND_PORT=8080
FRONTEND_PORT=3000
# Match the backend container's small connection/worker budget.
DB_POOL_SIZE=2
HTTP_THREADS=2
WORKER_THREADS=2
# Backend only. Import stays disabled until durable private storage is verified.
STORAGE_BACKEND=local
MIDI_IMPORT_ENABLED=false
# Native local path. Compose persists /app/storage; cloud /tmp is NOT durable.
STORAGE_PATH=./storage
# Existing S3 bucket: HTTPS endpoint without a path; fill real values privately.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Nonempty safe path segments (letters, digits, _ and -), separated by /.
S3_PREFIX=lostmidi
S3_PATH_STYLE=true
# Uploaded objects are publicly distributed; anonymous reads are allowed by design.
# Set true to acknowledge public distribution. This ACK is not a permission check.
# Never reuse exposed credentials or pass any S3 setting to the frontend.
S3_PUBLIC_DISTRIBUTION_CONFIRMED=false
# Never seed a production database. Opt in with true only in a disposable demo/test database.
SEED_DEMO=false

# Existing deployments may keep an environment-managed administrator.
# A complete pair takes precedence over the database administrator; never use plaintext here.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
# New installation: leave ADMIN_PASSWORD_HASH empty and generate a private token with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
# Set only on the backend. Empty disables installation; never use a shared default.
INSTALLATION_TOKEN=
# Exact browser origin, no trailing slash. Use HTTPS and secure cookies on a server.
ADMIN_ORIGIN=http://localhost:3000
ADMIN_COOKIE_SECURE=false
