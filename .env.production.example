# Production template: fill the database credentials and site URLs before starting Compose.
# Choose browser installation (INSTALLATION_TOKEN) or a complete legacy administrator pair.
POSTGRES_USER=lostmidi
POSTGRES_PASSWORD=
POSTGRES_DB=lostmidi
POSTGRES_PORT=5432
DATABASE_URL=
BACKEND_API_URL=http://backend:8080
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8080
FRONTEND_PORT=3000
DB_POOL_SIZE=4
HTTP_THREADS=2
WORKER_THREADS=4
STORAGE_PATH=./storage
SEED_DEMO=false
ADMIN_USERNAME=admin
# Optional legacy/override administrator. Generate using scripts/admin_password.py.
# For a new browser installation leave this empty and set INSTALLATION_TOKEN instead.
ADMIN_PASSWORD_HASH=
# Backend only: generate a unique secret using secrets.token_urlsafe(32), never a default.
# Remove after installation; the database installation lock remains in force.
INSTALLATION_TOKEN=
# Your HTTPS browser origin, without a trailing slash.
ADMIN_ORIGIN=
ADMIN_COOKIE_SECURE=true
