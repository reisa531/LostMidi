# Production Compose template: fill credentials and URLs privately before starting.
# Vercel: separate backend project uses Neon DATABASE_URL and backend-only settings.
# Do not bulk-copy this Compose template to Vercel: keep container BACKEND_HOST=0.0.0.0.
# Frontend project gets ONLY BACKEND_API_URL, ADMIN_ORIGIN, ADMIN_COOKIE_SECURE.
# Platform PORT takes precedence over BACKEND_PORT; do not override cloud PORT.
# Choose browser installation (INSTALLATION_TOKEN) or a complete legacy administrator pair.
POSTGRES_USER=lostmidi
POSTGRES_PASSWORD=
POSTGRES_DB=lostmidi
POSTGRES_PORT=5432
DATABASE_URL=
BACKEND_API_URL=http://backend:8080
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8080
FRONTEND_PORT=3000
# Backend container defaults; keep the Neon Free connection/worker budget small.
DB_POOL_SIZE=2
HTTP_THREADS=2
WORKER_THREADS=2
# Safe initial state. Cloud imports require verified private S3, not local /tmp.
STORAGE_BACKEND=local
MIDI_IMPORT_ENABLED=false
# Native local path; Compose persists /app/storage using ./storage.
STORAGE_PATH=./storage
# Backend only: existing real bucket; HTTPS endpoint without a path.
# Leave unknown values empty. Rotate exposed keys; never reuse them.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Nonempty safe segments (letters, digits, _ and -); / separates segments.
S3_PREFIX=lostmidi
S3_PATH_STYLE=true
# Uploaded objects are publicly distributed; anonymous reads are allowed by design.
# Set true to acknowledge public distribution. This ACK is not a permission check.
S3_PUBLIC_DISTRIBUTION_CONFIRMED=false
SEED_DEMO=false
ADMIN_USERNAME=admin
# Optional legacy/override administrator. Generate using scripts/admin_password.py.
# For a new browser installation leave this empty and set INSTALLATION_TOKEN instead.
ADMIN_PASSWORD_HASH=
# Backend only: generate a unique secret using secrets.token_urlsafe(32), never a default.
# Remove after installation; the database installation lock remains in force.
INSTALLATION_TOKEN=
# Your HTTPS browser origin, without a trailing slash.
ADMIN_ORIGIN=
ADMIN_COOKIE_SECURE=true
