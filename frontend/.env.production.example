# Frontend-only production configuration. Copy to .env.production.local for native
# hosting, or set these variables in the Vercel project (Production environment).
# No database credentials, administrator password, or INSTALLATION_TOKEN belong here.
# /install generates these three values; save them in Vercel and redeploy manually.
# A fresh backend also needs migrations and its own private INSTALLATION_TOKEN.

# HTTPS backend base URL reachable from Vercel; no trailing /api/v1.
# localhost, 127.0.0.1 and Docker service names do not reach your backend on Vercel.
BACKEND_API_URL=https://api.example.com

# Exact browser origin, with no path or trailing slash.
# After Vercel assigns the domain, set this value and redeploy before using /admin.
ADMIN_ORIGIN=https://your-project.vercel.app
ADMIN_COOKIE_SECURE=true

# Do not set NEXT_OUTPUT_STANDALONE on Vercel. frontend/Dockerfile sets it at build time.
