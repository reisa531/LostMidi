# Frontend-only local development. Copy to .env.local inside this directory.
# Start the C++ API separately; no parent .env, database or C++ toolchain is needed here.
# For Vercel / HTTPS hosting, use the values described in .env.production.example.
# First visit redirects to /install for a fresh backend. Configure INSTALLATION_TOKEN
# only on that backend, never here; apply database migrations before starting it.
# BACKEND_API_URL is also required at build time for file-transfer rewrites.
# Configure the same ADMIN_ORIGIN on the backend for cookie-authenticated uploads.
BACKEND_API_URL=http://localhost:8080
ADMIN_ORIGIN=http://localhost:3000
ADMIN_COOKIE_SECURE=false
