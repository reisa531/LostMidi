# Frontend-only local development. Copy to .env.local inside this directory.
# Start the C++ API separately; no parent .env, database or C++ toolchain is needed here.
# For Vercel / HTTPS hosting, use the values described in .env.production.example.
BACKEND_API_URL=http://localhost:8080
ADMIN_ORIGIN=http://localhost:3000
ADMIN_COOKIE_SECURE=false
